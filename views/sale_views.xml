<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         SALE TREE VIEW
    ========================================================== -->

    <record id="mobile_shop_sale_tree" model="ir.ui.view">
        <field name="name">mobile.shop.sale.tree</field>
        <field name="model">mobile.shop.sale</field>
        <field name="arch" type="xml">

            <tree
                decoration-success="payment_status == 'paid'"
                decoration-warning="payment_status == 'partial'"
                decoration-danger="payment_status == 'unpaid'"
            >

                <field name="name"/>
                <field name="customer_id"/>
                <field name="sale_date"/>

                <field name="subtotal"
                       widget="monetary"/>

                <field name="discount_amount"
                       widget="monetary"/>

                <field name="total_amount"
                       widget="monetary"/>

                <field name="amount_paid"
                       widget="monetary"/>

                <field name="amount_due"
                       widget="monetary"/>

                <field name="currency_id"
                       invisible="1"/>

                <field name="payment_status"
                       widget="badge"/>

                <field name="state"
                       widget="badge"/>

            </tree>

        </field>
    </record>


    <!-- =========================================================
         SALE KANBAN VIEW
    ========================================================== -->

    <record id="mobile_shop_sale_kanban" model="ir.ui.view">
        <field name="name">mobile.shop.sale.kanban</field>
        <field name="model">mobile.shop.sale</field>

        <field name="arch" type="xml">

            <kanban class="o_kanban_mobile_sales">

                <field name="name"/>
                <field name="customer_id"/>
                <field name="sale_date"/>

                <field name="total_amount"/>
                <field name="amount_paid"/>
                <field name="amount_due"/>

                <field name="currency_id"/>
                <field name="payment_status"/>
                <field name="state"/>

                <templates>

                    <t t-name="kanban-box">

                        <div
                            t-attf-class="
                                oe_kanban_global_click
                                o_kanban_record
                                #{record.payment_status.raw_value === 'paid'
                                    ? 'border-success'
                                    : record.payment_status.raw_value === 'partial'
                                    ? 'border-warning'
                                    : 'border-danger'}
                            "
                            style="
                                border-left: 4px solid;
                                padding: 16px;
                                margin-bottom: 8px;
                            "
                        >

                            <!-- HEADER -->

                            <div class="d-flex justify-content-between">

                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <field
                                    name="payment_status"
                                    widget="label_selection"
                                    options="{
                                        'classes': {
                                            'paid': 'success',
                                            'partial': 'warning',
                                            'unpaid': 'danger'
                                        }
                                    }"
                                />

                            </div>


                            <!-- CUSTOMER -->

                            <div class="mt-2">

                                <i class="fa fa-user mr-1"/>

                                <field name="customer_id"/>

                            </div>


                            <!-- DATE -->

                            <div class="text-muted">

                                <i class="fa fa-calendar mr-1"/>

                                <field name="sale_date"/>

                            </div>


                            <!-- TOTAL -->

                            <div class="mt-3">

                                <div class="text-muted">
                                    Total
                                </div>

                                <strong style="font-size: 20px;">

                                    <field
                                        name="total_amount"
                                        widget="monetary"
                                    />

                                </strong>

                            </div>


                            <!-- PAYMENT -->

                            <div class="mt-2">

                                <div>
                                    Paid:
                                    <field
                                        name="amount_paid"
                                        widget="monetary"
                                    />
                                </div>

                                <div t-if="record.amount_due.raw_value > 0"
                                     class="text-danger">

                                    Due:
                                    <field
                                        name="amount_due"
                                        widget="monetary"
                                    />

                                </div>

                            </div>


                            <!-- FOOTER -->

                            <div
                                class="mt-3 d-flex justify-content-between"
                            >

                                <span class="text-muted">
                                    <field name="state"/>
                                </span>

                                <span>

                                    <field
                                        name="currency_id"
                                        invisible="1"
                                    />

                                </span>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>


    <!-- =========================================================
         SALE FORM VIEW
    ========================================================== -->

    <record id="mobile_shop_sale_form" model="ir.ui.view">

        <field name="name">mobile.shop.sale.form</field>

        <field name="model">mobile.shop.sale</field>

        <field name="arch" type="xml">

            <form>

                <!-- =================================================
                     HEADER
                ================================================== -->

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm Sale"
                        type="object"
                        class="oe_highlight"
                        attrs="{
                            'invisible': [
                                ('state', '=', 'confirmed')
                            ]
                        }"
                    />

                    <button
                        name="%(action_report_mobile_shop_sale)d"
                        string="Print Receipt"
                        type="action"
                        class="btn-secondary"
                        attrs="{
                            'invisible': [
                                ('state', '!=', 'confirmed')
                            ]
                        }"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed"
                    />

                </header>


                <!-- =================================================
                     SHEET
                ================================================== -->

                <sheet>

                    <!-- TITLE -->

                    <div class="oe_title">

                        <label
                            for="name"
                            class="oe_edit_only"
                        />

                        <h1>

                            <field
                                name="name"
                                readonly="1"
                            />

                        </h1>

                    </div>


                    <!-- =================================================
                         CUSTOMER / SALE INFORMATION
                    ================================================== -->

                    <group>

                        <group string="Sale Information">

                            <field
                                name="customer_id"
                                options="{
                                    'no_create': False
                                }"
                                attrs="{
                                    'readonly': [
                                        ('state', '=', 'confirmed')
                                    ]
                                }"
                            />

                            <field name="sale_date"/>

                        </group>


                        <group string="Payment Summary">

                            <field
                                name="currency_id"
                                invisible="1"
                            />

                            <field
                                name="subtotal"
                                widget="monetary"
                                readonly="1"
                            />

                            <field
                                name="discount_amount"
                                widget="monetary"
                                readonly="1"
                            />

                            <field
                                name="total_amount"
                                widget="monetary"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- =================================================
                         SALE ITEMS
                    ================================================== -->

                    <notebook>

                        <page string="Items">

                            <field
                                name="line_ids"
                                attrs="{
                                    'readonly': [
                                        ('state', '=', 'confirmed')
                                    ]
                                }"
                            >

                                <tree editable="bottom">

                                    <field
                                        name="product_id"
                                        options="{
                                            'no_create': True
                                        }"
                                    />

                                    <field
                                        name="device_id"
                                        domain="[
                                            ('state', '=', 'available'),
                                            ('product_id', '=', product_id)
                                        ]"
                                    />

                                    <field name="quantity"/>

                                    <field name="unit_price"/>

                                    <field name="cost_price"/>

                                    <field name="discount"/>

                                    <field
                                        name="subtotal"
                                        readonly="1"
                                    />

                                    <field
                                        name="profit"
                                        readonly="1"
                                    />

                                    <field
                                        name="currency_id"
                                        invisible="1"
                                    />

                                </tree>

                            </field>

                        </page>


                        <!-- =================================================
                             PAYMENT
                        ================================================== -->

                       <page string="Payments">

    <field
        name="payment_ids"
        attrs="{
            'readonly': [
                ('state', '=', 'confirmed')
            ]
        }"
    >

        <tree editable="bottom">

            <field name="payment_date"/>

            <field name="payment_method"/>

            <field name="amount"/>

            <field
                name="reference"
                attrs="{
                    'invisible': [
                        ('payment_method', '=', 'cash')
                    ]
                }"
            />

            <field name="state"/>

            <field
                name="currency_id"
                invisible="1"
            />

        </tree>

    </field>

    <group class="mt-3">

        <group>

            <field
                name="amount_paid"
                widget="monetary"
                readonly="1"
            />

            <field
                name="amount_due"
                widget="monetary"
                readonly="1"
            />

        </group>

        <group>

            <field
                name="payment_status"
                widget="badge"
                readonly="1"
            />

        </group>

    </group>

</page>


                        <!-- =================================================
                             NOTES
                        ================================================== -->

                        <page string="Notes">

                            <field
                                name="notes"
                                placeholder="Add notes about this sale..."
                            />

                        </page>

                    </notebook>


                    <!-- =================================================
                         TOTAL BOX
                    ================================================== -->

                    <group class="oe_subtotal_footer oe_right">

                        <field
                            name="subtotal"
                            widget="monetary"
                            readonly="1"
                        />

                        <field
                            name="discount_amount"
                            widget="monetary"
                            readonly="1"
                        />

                        <field
                            name="total_amount"
                            widget="monetary"
                            class="oe_subtotal_footer_separator"
                            readonly="1"
                        />

                        <field
                            name="amount_paid"
                            widget="monetary"
                            readonly="1"
                        />

                        <field
                            name="amount_due"
                            widget="monetary"
                            class="oe_subtotal_footer_separator"
                            readonly="1"
                        />

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- =========================================================
         SEARCH VIEW
    ========================================================== -->

    <record id="mobile_shop_sale_search" model="ir.ui.view">

        <field name="name">mobile.shop.sale.search</field>

        <field name="model">mobile.shop.sale</field>

        <field name="arch" type="xml">

            <search>

                <field
                    name="name"
                    string="Bill Number"
                />

                <field
                    name="customer_id"
                    string="Customer"
                />

                <field
                    name="sale_date"
                    string="Sale Date"
                />

                <field
                    name="payment_status"
                    string="Payment Status"
                />

                <field
                    name="state"
                    string="Status"
                />


                <separator/>


                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />

                <filter
                    name="confirmed"
                    string="Confirmed"
                    domain="[('state', '=', 'confirmed')]"
                />

                <filter
                    name="paid"
                    string="Paid"
                    domain="[('payment_status', '=', 'paid')]"
                />

                <filter
                    name="partial"
                    string="Partially Paid"
                    domain="[('payment_status', '=', 'partial')]"
                />

                <filter
                    name="unpaid"
                    string="Unpaid"
                    domain="[('payment_status', '=', 'unpaid')]"
                />


                <separator/>


                <filter
                    name="today"
                    string="Today"
                    domain="[
                        ('sale_date', '=', context_today())
                    ]"
                />


                <group expand="0" string="Group By">

                    <filter
                        name="group_customer"
                        string="Customer"
                        context="{
                            'group_by': 'customer_id'
                        }"
                    />

                    <filter
                        name="group_date"
                        string="Sale Date"
                        context="{
                            'group_by': 'sale_date'
                        }"
                    />

                    <filter
                        name="group_payment"
                        string="Payment Status"
                        context="{
                            'group_by': 'payment_status'
                        }"
                    />

                    <filter
                        name="group_state"
                        string="Status"
                        context="{
                            'group_by': 'state'
                        }"
                    />

                </group>

            </search>

        </field>

    </record>


    <!-- =========================================================
         ACTION
    ========================================================== -->

    <record id="mobile_shop_sale_action" model="ir.actions.act_window">

        <field name="name">Billing</field>

        <field name="res_model">mobile.shop.sale</field>

        <field name="view_mode">kanban,tree,form</field>

        <field name="search_view_id"
               ref="mobile_shop_sale_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first sale
            </p>

            <p>
                Create a bill, add phones or accessories,
                record the payment and confirm the sale.
            </p>

        </field>

    </record>


    <!-- =========================================================
         MENU
    ========================================================== -->

    <menuitem
        id="mobile_shop_sale_menu"
        name="Billing"
        parent="mobile_shop_root_menu"
        action="mobile_shop_sale_action"
        sequence="20"
    />

</odoo>