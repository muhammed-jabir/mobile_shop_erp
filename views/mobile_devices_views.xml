<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->

    <record id="mobile_shop_device_tree" model="ir.ui.view">
        <field name="name">mobile.shop.device.tree</field>
        <field name="model">mobile.shop.device</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'available'"
                  decoration-danger="state == 'sold'"
                  decoration-warning="state == 'repair'"
                  decoration-muted="state == 'returned'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="imei_1"/>
                <field name="imei_2"/>
                <field name="supplier_id"/>
                <field name="customer_id"/>
                <field name="purchase_price" widget="monetary"/>
                <field name="sale_price" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <!-- KANBAN VIEW -->

    <record id="mobile_shop_device_kanban" model="ir.ui.view">
        <field name="name">mobile.shop.device.kanban</field>
        <field name="model">mobile.shop.device</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile_devices">
                <field name="name"/>
                <field name="product_id"/>
                <field name="imei_1"/>
                <field name="customer_id"/>
                <field name="sale_price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record #{record.state.raw_value === 'available' ? 'border-left border-success' : record.state.raw_value === 'sold' ? 'border-left border-danger' : record.state.raw_value === 'repair' ? 'border-left border-warning' : 'border-left border-secondary'}"
                             style="border-left-width: 4px; padding: 10px;">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="product_id"/><br/>
                                <span>IMEI: <field name="imei_1"/></span><br/>
                                <field name="customer_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="sale_price" widget="monetary"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'available': 'success', 'sold': 'danger', 'repair': 'warning', 'returned': 'default'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- FORM VIEW -->

    <record id="mobile_shop_device_form" model="ir.ui.view">
        <field name="name">mobile.shop.device.form</field>
        <field name="model">mobile.shop.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money"
                                attrs="{'invisible': [('sale_count', '=', 0)]}">
                            <field name="sale_count" widget="statinfo" string="Sale"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Device">
                            <field name="product_id"/>
                            <field name="imei_1"/>
                            <field name="imei_2"/>
                            <field name="serial_number"/>
                        </group>
                        <group string="Purchase">
                            <field name="supplier_id"/>
                            <field name="purchase_date"/>
                            <field name="purchase_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Sale">
                        <field name="customer_id"/>
                        <field name="sale_date"/>
                        <field name="sale_price"/>
                    </group>
                    <group string="Warranty">
                        <field name="warranty_start"/>
                        <field name="warranty_end"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- SEARCH VIEW -->

    <record id="mobile_shop_device_search" model="ir.ui.view">
        <field name="name">mobile.shop.device.search</field>
        <field name="model">mobile.shop.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="imei_1"/>
                <field name="supplier_id"/>
                <field name="customer_id"/>
                <filter string="Available" name="filter_available"
                        domain="[('state', '=', 'available')]"/>
                <filter string="Sold" name="filter_sold"
                        domain="[('state', '=', 'sold')]"/>
                <filter string="Under Repair" name="filter_repair"
                        domain="[('state', '=', 'repair')]"/>
                <filter string="Returned" name="filter_returned"
                        domain="[('state', '=', 'returned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_by_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Status" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Supplier" name="group_by_supplier"
                            context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- ACTION -->

    <record id="mobile_shop_device_action" model="ir.actions.act_window">
        <field name="name">Mobile Devices</field>
        <field name="res_model">mobile.shop.device</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="mobile_shop_device_search"/>
    </record>


    <!-- STOCK STATUS ACTION -->

    <record id="mobile_shop_stock_status_action" model="ir.actions.act_window">
        <field name="name">Stock Status</field>
        <field name="res_model">mobile.shop.device</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="mobile_shop_device_search"/>
        <field name="context">{'search_default_group_by_product': 1}</field>
    </record>


    <!-- MENU -->

    <menuitem id="mobile_shop_root_menu" name="Mobile Shop" sequence="10"/>

    <menuitem id="mobile_shop_device_menu"
              name="Mobile Devices"
              parent="mobile_shop_root_menu"
              action="mobile_shop_device_action"
              sequence="10"/>

    <menuitem id="mobile_shop_stock_status_menu"
              name="Stock Status"
              parent="mobile_shop_root_menu"
              action="mobile_shop_stock_status_action"
              sequence="15"/>

</odoo>