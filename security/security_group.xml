<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_mobile_shop" model="ir.module.category">
        <field name="name">Mobile Shop</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_mobile_shop_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_mobile_shop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mobile_shop_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="category_id" ref="module_category_mobile_shop"/>
        <field name="implied_ids" eval="[(4, ref('group_mobile_shop_staff'))]"/>
    </record>

</odoo>